flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    entry["New task<br/>thread_id"]:::app

    subgraph Readiness["build_assessment_graph"]
        prepare["prepare<br/>discover, reconcile,<br/>policy, audit intent"]:::core
        audit["audit<br/>commit to AGXAI"]:::core
        route{"route"}:::core
        pause["interrupt<br/>ClarificationPayload"]:::core
        apply["apply_response<br/>validate answers"]:::core
    end

    host["Host collects answers<br/>Command(resume=...)"]:::app
    checkpointer["Checkpointer<br/>authoritative graph state"]:::provider
    supervisor["Supervisor"]:::app
    workers["Researcher, developer,<br/>tester, tools"]:::app

    entry --> prepare --> audit --> route
    route -- "needs answers" --> pause
    pause -. "same thread" .-> host -.-> apply
    apply --> prepare
    route -- "done: readiness" --> supervisor --> workers --> supervisor
    Readiness <-.-> checkpointer
