flowchart LR
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547

    entry["New task<br/>thread_id"]:::app

    readiness["Readiness assessment<br/>build_assessment_graph"]:::core
    interrupt["Clarification interrupt"]:::core
    host["Host collects answers<br/>and resumes the same thread"]:::app
    checkpointer["Checkpointer<br/>authoritative graph state"]:::provider
    supervisor["Supervisor"]:::app
    workers["Researcher, developer,<br/>tester, tools"]:::app

    entry --> readiness
    readiness -- "needs clarification" --> interrupt --> host --> readiness
    readiness -- "readiness result" --> supervisor --> workers --> supervisor
    readiness <-. "saved graph state" .-> checkpointer
