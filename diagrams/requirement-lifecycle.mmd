flowchart LR
    classDef status fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef ok fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef stop fill:#fff7e8,stroke:#c98a12,color:#0f2547

    proposed["Requirement proposal"]:::status
    check{"Supported by task<br/>or its accepted answer?"}:::status
    available["Available"]:::ok
    unresolved["Unresolved<br/>may block the task"]:::stop
    assumed["Approved assumption"]:::ok
    declined["Declined"]:::stop
    answer["Answer for the<br/>identified requirement"]:::status
    reassess["Reassess readiness"]:::status
    lineage["Changed meaning<br/>uses explicit lineage"]:::stop

    proposed --> check
    check -- "supported" --> available
    check -- "not supported" --> unresolved
    unresolved -- "clarification" --> answer --> reassess
    unresolved -- "host approves" --> assumed
    unresolved -- "user declines" --> declined
    reassess --> check
    available -- "meaning changes" --> lineage --> proposed
