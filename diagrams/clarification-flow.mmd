flowchart TD
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547
    classDef stop fill:#fff7e8,stroke:#c98a12,color:#0f2547

    blocker["Information is missing"]:::core
    assess{"Can it be resolved<br/>by asking or an approved assumption?"}:::core
    ask["Ask the application user"]:::core
    assume["Use an assumption only<br/>when enabled and approved"]:::core
    block["Remain not ready"]:::stop
    plan["Prepare clarification questions"]:::core
    payload["ClarificationPayload"]:::app
    response["Answers or declines"]:::app
    validate{"Valid for the<br/>requirement?"}:::core
    accept["Accept the answer<br/>for its requirement"]:::core
    followup["Request a corrected<br/>or missing answer"]:::core
    reassess["Reassess readiness"]:::core

    blocker --> assess
    assess -- "ask" --> ask --> plan --> payload --> response --> validate
    assess -- "approved assumption" --> assume --> reassess
    assess -- "no" --> block
    validate -- "yes" --> accept --> reassess
    validate -- "no or partial" --> followup --> payload
