flowchart LR
    classDef core fill:#eef4ff,stroke:#3567c7,color:#0f2547
    classDef provider fill:#fff7e8,stroke:#c98a12,color:#0f2547
    classDef app fill:#ecf8f1,stroke:#2f8f5b,color:#0f2547

    state["Assessment outcome<br/>and opaque references"]:::core

    subgraph AGXAI["AGXAI"]
        execution["Execution and events"]:::provider
        evidence["Evidence"]:::provider
        decision["Decision"]:::provider
        links["Evidence-to-decision links"]:::provider
    end

    result["Readiness result with audit references"]:::app
    retry["Retryable audit failure<br/>resume the assessment"]:::app

    state --> execution
    state --> evidence
    state --> decision
    evidence --> links
    decision --> links
    links --> result
    AGXAI -- "write fails" --> retry
